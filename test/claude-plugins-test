#!/usr/bin/env bash

set -euo pipefail

test_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
root="${test_dir%/test}"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fail() {
  printf 'claude-plugins-test: %s\n' "$*" >&2
  exit 1
}

assert_contains() {
  local value=$1
  local expected=$2

  [[ "$value" == *"$expected"* ]] ||
    fail "expected output to contain: $expected"
}

check_shell() {
  local -a shell_files=()

  local file
  while IFS= read -r file; do
    shell_files+=("$file")
  done < <(git -C "$root" ls-files '*.sh')
  shell_files+=("test/claude-plugins-test")
  ((${#shell_files[@]} > 0)) || fail "no shell entry points found"

  for file in "${shell_files[@]}"; do
    bash -n "$root/$file"
  done
  shellcheck -x "${shell_files[@]/#/$root/}"
}

check_manifests() {
  local marketplace="$root/.claude-plugin/marketplace.json"
  jq -e '
    .name | type == "string" and length > 0
  ' "$marketplace" >/dev/null
  jq -e '
    .plugins | length > 0 and
    ([.[].name] | length == (unique | length)) and
    ([.[].source] | length == (unique | length))
  ' "$marketplace" >/dev/null

  local name source plugin_root manifest manifest_name
  while IFS=$'\t' read -r name source; do
    plugin_root="$root/${source#./}"
    manifest="$plugin_root/.claude-plugin/plugin.json"
    [[ -d "$plugin_root" ]] || fail "missing plugin source for $name: $source"
    [[ -f "$manifest" ]] || fail "missing plugin manifest for $name"
    manifest_name=$(jq -er '.name' "$manifest")
    [[ "$manifest_name" == "$name" ]] ||
      fail "marketplace name $name does not match manifest name $manifest_name"
    jq -e '.version | type == "string" and length > 0' "$manifest" >/dev/null
    jq -e '.skills[]' "$manifest" >/dev/null
  done < <(jq -r '.plugins[] | [.name, .source] | @tsv' "$marketplace")
}

check_installer() {
  local fake_bin="$tmp/fake-bin"
  local command_log="$tmp/claude-commands"
  mkdir -p "$fake_bin"

  cat >"$fake_bin/claude" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$CLAUDE_COMMAND_LOG"
exit "${FAKE_CLAUDE_STATUS:-0}"
EOF
  cat >"$fake_bin/curl" <<'EOF'
#!/usr/bin/env bash
if [[ "${FAKE_CURL_FAIL:-0}" == 1 ]]; then
  exit 22
fi
cat "$MARKETPLACE_FIXTURE"
EOF
  chmod +x "$fake_bin/claude" "$fake_bin/curl"

  CLAUDE_COMMAND_LOG="$command_log" \
    FAKE_CLAUDE_STATUS=1 \
    MARKETPLACE_FIXTURE="$root/.claude-plugin/marketplace.json" \
    PATH="$fake_bin:$PATH" \
    bash "$root/install.sh"

  expected=$(
    cat <<'EOF'
plugin marketplace add cgraf78/claude-plugins
plugin marketplace update cgraf78-claude-plugins
plugin install status-line
plugin update status-line
EOF
  )
  actual=$(cat "$command_log")
  [[ "$actual" == "$expected" ]] || fail "installer issued unexpected Claude commands"

  if CLAUDE_COMMAND_LOG="$command_log" \
    FAKE_CURL_FAIL=1 \
    MARKETPLACE_FIXTURE="$root/.claude-plugin/marketplace.json" \
    PATH="$fake_bin:$PATH" \
    bash "$root/install.sh" >"$tmp/install-failure.out" 2>"$tmp/install-failure.err"; then
    fail "installer accepted an unavailable marketplace"
  fi
  assert_contains "$(cat "$tmp/install-failure.err")" \
    "error: failed to fetch marketplace.json"
}

check_status_line() {
  local home="$tmp/home"
  local work="$home/work"
  local status_bin="$tmp/status-bin"
  local git_log="$tmp/status-git.log"
  local transcript_log="$tmp/status-transcript.log"
  local transcript="$tmp/transcript.jsonl"
  local real_git real_jq real_path
  mkdir -p "$work" "$status_bin"
  git -C "$work" init -q
  git -C "$work" checkout -q -b main
  printf 'changed\n' >"$work/dirty.txt"
  cat >"$transcript" <<'EOF'
{"type":"user","message":{"content":"first prompt"}}
{"type":"assistant","message":{"content":"response"}}
{"type":"custom-title","customTitle":"Performance scrub"}
{"type":"user","message":{"content":"second prompt"}}
EOF

  real_git=$(command -v git)
  real_jq=$(command -v jq)
  real_path=$PATH
  cat >"$status_bin/git" <<'EOF'
#!/usr/bin/env bash
printf '%s\n' "$*" >>"$STATUS_GIT_LOG"
PATH="$STATUS_REAL_PATH" exec "$STATUS_REAL_GIT" "$@"
EOF
  cat >"$status_bin/jq" <<'EOF'
#!/usr/bin/env bash
for arg in "$@"; do
  if [[ "$arg" == "$STATUS_TRANSCRIPT" ]]; then
    printf 'scan\n' >>"$STATUS_TRANSCRIPT_LOG"
    break
  fi
done
exec "$STATUS_REAL_JQ" "$@"
EOF
  chmod +x "$status_bin/git" "$status_bin/jq"

  local input output plain git_calls transcript_scans
  # shellcheck disable=SC2016 # $cwd and $transcript are jq variables.
  input=$("$real_jq" -cn --arg cwd "$work" --arg transcript "$transcript" '{
    workspace: {current_dir: $cwd},
    model: {id: "claude-sonnet-4-5-20250929"},
    context_window: {used_percentage: 42},
    cost: {total_cost_usd: 1.23},
    transcript_path: $transcript
  }')
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')

  assert_contains "$plain" "ci-host | ~/work (main %)"
  assert_contains "$plain" "Performance scrub"
  assert_contains "$plain" "sonnet-4.5"
  assert_contains "$plain" "42%"
  assert_contains "$plain" "\$1.23"
  assert_contains "$plain" "2 turns"

  git_calls=$(wc -l <"$git_log" | tr -d '[:space:]')
  transcript_scans=$(wc -l <"$transcript_log" | tr -d '[:space:]')
  printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh" >/dev/null
  [[ "$(wc -l <"$git_log" | tr -d '[:space:]')" == "$git_calls" ]] ||
    fail "status line repeated Git discovery for unchanged input"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$transcript_scans" ]] ||
    fail "status line rescanned an unchanged transcript"

  printf '%s\n' '{"type":"user","message":{"content":"third prompt"}}' >>"$transcript"
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "3 turns"
  [[ "$(wc -l <"$git_log" | tr -d '[:space:]')" == "$git_calls" ]] ||
    fail "status line discarded a valid Git cache after transcript growth"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$transcript_scans" ]] ||
    fail "status line rescanned the full transcript after an append"

  printf '%s' '{"type":"user","message":' >>"$transcript"
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "Performance scrub"
  assert_contains "$plain" "3 turns"

  printf '%s\n' '{"content":"fourth prompt"}}' >>"$transcript"
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "4 turns"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$transcript_scans" ]] ||
    fail "status line rescanned the full transcript while completing a partial record"

  cat >"$transcript" <<'EOF'
{"type":"assistant","message":{"content":"prefix padding prefix padding prefix padding prefix padding prefix padding prefix padding"}}
{"type":"custom-title","customTitle":"Original"}
{"type":"user","message":{"content":"replacement prompt"}}
{"type":"assistant","message":{"content":"suffix padding suffix padding suffix padding suffix padding suffix padding suffix padding"}}
EOF
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "Original"
  cp -p "$transcript" "$tmp/transcript-timestamp"
  sleep 1

  cat >"$transcript" <<'EOF'
{"type":"assistant","message":{"content":"prefix padding prefix padding prefix padding prefix padding prefix padding prefix padding"}}
{"type":"custom-title","customTitle":"Replaced"}
{"type":"user","message":{"content":"replacement prompt"}}
{"type":"assistant","message":{"content":"suffix padding suffix padding suffix padding suffix padding suffix padding suffix padding"}}
EOF
  touch -r "$tmp/transcript-timestamp" "$transcript"
  transcript_scans=$(wc -l <"$transcript_log" | tr -d '[:space:]')
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "Replaced"
  [[ "$plain" != *"Original"* ]] || fail "status line reused a stale same-inode transcript cache"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$((transcript_scans + 1))" ]] ||
    fail "status line did not fully rescan a replaced same-inode transcript"

  cat >"$tmp/atomic-replacement.jsonl" <<'EOF'
{"type":"custom-title","customTitle":"Atomic replacement"}
{"type":"user","message":{"content":"replacement prompt one"}}
{"type":"user","message":{"content":"replacement prompt two"}}
EOF
  mv "$tmp/atomic-replacement.jsonl" "$transcript"
  transcript_scans=$(wc -l <"$transcript_log" | tr -d '[:space:]')
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "Atomic replacement"
  assert_contains "$plain" "2 turns"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$((transcript_scans + 1))" ]] ||
    fail "status line did not fully rescan a replacement inode"

  transcript_scans=$((transcript_scans + 1))
  printf '%s\n' '{"type":"user","message":{"content":"after truncation"}}' >"$transcript"
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "1 turns"
  [[ "$plain" != *"Atomic replacement"* ]] || fail "status line reused cache state after truncation"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$((transcript_scans + 1))" ]] ||
    fail "status line did not fully rescan a truncated transcript"

  transcript_scans=$((transcript_scans + 1))
  awk 'BEGIN {
    for (i = 1; i <= 20000; i++) {
      if (i % 2 == 0)
        print "{\"type\":\"user\",\"message\":{\"content\":\"bounded growth prompt\"}}"
      else
        print "{\"type\":\"assistant\",\"message\":{\"content\":\"bounded response\"}}"
    }
  }' >>"$transcript"
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "10001 turns"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$transcript_scans" ]] ||
    fail "status line fully rescanned a large appended transcript"

  printf '%s\n' '{"type":"user","message":{"content":"bounded tail append"}}' >>"$transcript"
  output=$(printf '%s' "$input" |
    HOME="$home" HOSTNAME=ci-host PATH="$status_bin:$PATH" \
      XDG_CACHE_HOME="$home/.cache" \
      CLAUDE_STATUS_LINE_CACHE_TTL_SECONDS=60 \
      STATUS_GIT_LOG="$git_log" STATUS_REAL_GIT="$real_git" \
      STATUS_REAL_PATH="$real_path" \
      STATUS_REAL_JQ="$real_jq" STATUS_TRANSCRIPT="$transcript" \
      STATUS_TRANSCRIPT_LOG="$transcript_log" \
      bash "$root/plugins/status-line/scripts/status-line.sh")
  plain=$(printf '%s' "$output" | sed $'s/\033\\[[0-9;]*m//g')
  assert_contains "$plain" "10002 turns"
  [[ "$(wc -l <"$transcript_log" | tr -d '[:space:]')" == "$transcript_scans" ]] ||
    fail "status line fully rescanned after a bounded tail append"
}

check_shell
check_manifests
check_installer
check_status_line

printf 'claude-plugins-test: ok\n'
